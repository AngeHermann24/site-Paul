{
  "name": "paul-official",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PAUL — Official Boxing & Sports Experience",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "node scripts/e2e-server.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "db:test": "node scripts/db-test.mjs",
    "db:types": "node scripts/gen-db-types.mjs",
    "test:admin": "node scripts/test-admin.mjs",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "a11y": "node scripts/a11y-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@hookform/resolvers": "7.0.6",
    "@supabase/supabase-js": "2.119.0",
    "framer-motion": "14.14.0",
    "gsap": "3.15.1",
    "i18next": "27.1.1",
    "lenis": "1.3.27",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-helmet-async": "3.1.0",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  }
}
