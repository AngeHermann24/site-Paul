# ------------------------------------------------------------------
# PAUL — variables d'environnement PUBLIQUES (exposées au navigateur)
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# NE JAMAIS mettre la clé `service_role` dans ce fichier ni dans le frontend.
# ------------------------------------------------------------------

# URL publique du site, sans slash final (canonical, hreflang, Open Graph, sitemap)
VITE_SITE_URL=https://www.example.com

# Supabase — Project Settings > API (« Project URL » et clé « anon public »)
# La clé anon est publique par conception : la sécurité repose sur la RLS.
# ⚠️ La clé service_role ne doit JAMAIS apparaître ici ni dans le frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Afficher les contenus DEMO (seed.sql) dans un build de production (préproduction uniquement).
# Par défaut : visibles en `npm run dev`, masqués en `npm run build`.
VITE_ALLOW_DEMO_CONTENT=false

# Médias du hero (chemin dans public/media/ ou URL Supabase Storage). Vide = placeholder sombre.
# Ex. : VITE_HERO_VIDEO_MP4=/media/hero-1080.mp4
VITE_HERO_VIDEO_MP4=
VITE_HERO_VIDEO_WEBM=
VITE_HERO_VIDEO_MOBILE_MP4=
VITE_HERO_POSTER=

# Cloudflare Turnstile (optionnel — anti-spam des formulaires)
# La SECRET key Turnstile se configure côté Edge Function, jamais ici.
VITE_TURNSTILE_SITE_KEY=

# Mettre `true` une fois l'Edge Function `submit-request` déployée (supabase/functions/submit-request) :
# validation serveur, vérification Turnstile, URLs d'upload signées pour les pièces jointes,
# notification email (Resend). Sinon, les formulaires font un INSERT direct (fichiers désactivés).
VITE_SUBMIT_FUNCTION=false

# ------------------------------------------------------------------
# Côté Edge Function uniquement (secrets Supabase, `supabase secrets set`) :
#   TURNSTILE_SECRET_KEY   — vérifie les jetons côté serveur (optionnel)
#   RESEND_API_KEY         — notification email (optionnel)
#   NOTIFY_EMAIL_TO        — destinataire des notifications
#   NOTIFY_EMAIL_FROM      — expéditeur vérifié Resend, ex. « PAUL <noreply@domaine.tld> »
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement par la plateforme.
# ------------------------------------------------------------------
